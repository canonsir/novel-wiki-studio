s/manuscript/latest.md","evidenceCount":1}},{"id":"chapter:0001","type":"novel-node","meta":{"position":{"x":-3360,"y":-650}},"data":{"title":"第1章 白鹿的瞬间","kind":"chapter","summary":"我叫顾北辰。 名字是我爸给起的。他说出自《论语·为政》，\"为政以德，譬如北辰，居其所而众星共之\"。那年我六岁，他把我举到肩膀上，指着夜里最亮的那颗星教我念——\"北辰\"。 我没懂。我只记得他身上有股淡淡的旧书味，和院子里的桂花混在一起，有点呛。 现在我二十岁，大二。蓉城某三流大专。我爸被我妈的娘家叫作\"顾崇岳\"，被街坊叫作\"顾老头\"，被我叫作——\"**我去年买","canon":"confirmed","status":"proofread","sourcePath":"novels/my-glory/drafts/manuscript/latest.md","chapter":1,"phase":"完整校订稿"}},{"id":"rewrite:drafts/chapters/s1a-encounter-trap/c001-白鹿的瞬间.md","type":"novel-node","meta":{"position":{"x":7200,"y":-650}},"data":{"title":"白鹿的瞬间","kind":"chapter","summary":"我叫顾北辰。","canon":"proposed","status":"draft","sourcePath":"novels/my-glory/drafts/chapters/s1a-encounter-trap/c001-白鹿的瞬间.md","chapter":1,"phase":"s1a-encounter-trap"}}],"edges":[{"sourceNodeID":"novel:my-glory","targetNodeID":"category:root","data":{"relation":"包含","weight":1}},{"sourceNodeID":"category:root","targetNodeID":"wiki:overview","data":{"relation":"收录","weight":1}},{"sourceNodeID":"novel:my-glory","targetNodeID":"category:plot","data":{"relation":"包含","weight":6}},{"sourceNodeID":"category:plot","targetNodeID":"wiki:clue-ledger","data":{"relation":"收录","weight":1}},{"sourceNodeID":"category:plot","targetNodeID":"wiki:structure-ending-brief","data":{"relation":"收录","weight":1}},{"sourceNodeID":"category:plot","targetNodeID":"wiki:relationship-matrix","data":{"relation":"收录","weight":1}},{"sourceNodeID":"category:plot","targetNodeID":"wiki:structure-naming-palette","data":{"relation":"收录","weight":1}},{"sourceNodeID":"category:plot","targetNodeID":"wiki:structure-sensitive-redlines","data":{"relation":"收录","weight":1}},{"sourceNodeID":"category:plot","targetNodeID":"wiki:structure-rush-cadence","data":{"relation":"收录","weight":1}},{"sourceNodeID":"novel:my-glory","targetNodeID":"category:character","data":{"relation":"包含","weight":24}},{"sourceNodeID":"category:character","targetNodeID":"wik